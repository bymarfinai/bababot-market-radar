[Unit]
Description=BabaBot VPS2 research-only Binance Futures OHLCV archive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bababot-strong-sync
EnvironmentFile=/home/ubuntu/bababot-strong-sync/blob.env
Environment=STRONG_EXPORT_ROOT=/home/ubuntu/market-detektor-research
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.3/bin/node /home/ubuntu/bababot-strong-sync/archive-strong-candles.mjs --limit=10
TimeoutStartSec=110
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bababot-strong-sync/state
MemoryMax=224M
CPUQuota=20%
LimitNOFILE=128
