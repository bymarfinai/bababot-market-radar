[Unit]
Description=BabaBot vNext VPS2 PAPER snapshot publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bababot-strong-sync
EnvironmentFile=/home/ubuntu/bababot-strong-sync/blob.env
Environment=STRONG_EXPORT_ROOT=/home/ubuntu/market-detektor-research
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.3/bin/node /home/ubuntu/bababot-strong-sync/publish-strong-vps2.mjs
TimeoutStartSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bababot-strong-sync/state
MemoryMax=192M
CPUQuota=25%
LimitNOFILE=128

[Install]
WantedBy=multi-user.target
