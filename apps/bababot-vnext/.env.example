# Optional: server-only HTTPS bridge to the read-only VPS2 service.
# Requires an independently provisioned authenticated endpoint.
STRONG_READ_API_URL=
STRONG_READ_API_TOKEN=

# Preview fallback: sanitized JSON exported from VPS2.
# Supply this as a SERVER-ONLY preview environment variable, NOT NEXT_PUBLIC_.
# Never commit real trade snapshots to public Git.
STRONG_PAPER_SNAPSHOT_JSON=
