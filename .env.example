# BabaBot core-prod runtime.
# Copy to .env and replace all CHANGE_ME values.
# Never commit .env or .env.* runtime copies.

# Public HTTPS endpoints used by Caddy.
API_DOMAIN=core-prod.43-153-193-103.sslip.io
DASHBOARD_DOMAIN=radar.43-153-193-103.sslip.io

# PostgreSQL (internal Docker network only; no public 5432 mapping).
POSTGRES_DB=bababot
POSTGRES_USER=bababot
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

# Safe defaults. Production may enable paper/AI after restore and validation.
PAPER_TRADING_ENABLED=false
# PT-L1 opt-in. Keep generic until Stage3C7A paper validation is explicitly enabled.
PAPER_LONG_DETECTOR_POLICY=generic
AI_APPROVAL_ENABLED=false
LIVE_TRADING_ENABLED=false

# Browser control plane.
CONTROL_API_TOKEN=CHANGE_ME_LONG_RANDOM_CONTROL_TOKEN

# Binance credentials. Keep blank while live trading is disabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI providers/models used by the current production architecture.
AI_PROVIDER=clario
AI_PRIMARY_PROVIDER=clario1
AI_PRIMARY_MODEL=gpt-5.6-sol

# Stage 11 V3 fast pool: one signal is reviewed by one fast lane.
AI_FAST_POOL_TARGETS=clario1:gpt-5.6-sol
# Optional after CLARIO_API_KEY_2 is validated:
# AI_FAST_POOL_TARGETS=clario1:gpt-5.6-sol,clario2:gpt-5.6-sol
AI_APPROVAL_WORKERS=4
AI_APPROVAL_MAX_PER_SCAN=24
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS=2
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS_CLARIO=2
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS_CLARIO1=2
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS_CLARIO2=2
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS_THIRTY=2

# Stage 11C deterministic fresh-direction gate.
STAGE11C_MAX_PER_CYCLE=12
STAGE11C_MAX_SIGNAL_AGE_SECONDS=180
STAGE11C_MAX_APPROVAL_AGE_SECONDS=120
STAGE11C_FILL_MAX_AGE_SECONDS=30
STAGE11C_MAX_CHASE_PCT=0.75
STAGE11C_SOFT_CHASE_PCT=0.50
STAGE11C_MAX_ADVERSE_PCT=0.75
STAGE11C_RET1_THRESHOLD_PCT=0.01
STAGE11C_RET3_THRESHOLD_PCT=0.03
STAGE11C_TAKER_BUY_SHARE=0.55
STAGE11C_TAKER_SELL_SHARE=0.45
STAGE11C_OI_MIN_CHANGE_PCT=0.05
STAGE11C_IMPULSE_CONCENTRATION_RATIO=0.80
STAGE11C_IMPULSE_RET1_MIN_PCT=0.20

CLARIO_API_KEY=
CLARIO_API_KEY_2=
THIRTY_API_KEY=

# Paper trading defaults currently used on core-prod.
# Binance USD-M regular taker benchmark: 0.05% per side. Slippage remains a separate model input.
PAPER_NOTIONAL_USDT=500
PAPER_FEE_RATE=0.0005
PAPER_SLIPPAGE_BPS=2
PAPER_MAX_OPEN_POSITIONS=5
PAPER_POLL_SECONDS=10

# Stage 12 V3: fast wrong-direction + profit-protection guard.
# Explicit opt-in is intentional; production enables it after dry-run validation.
STAGE12_V3_FAST_GUARD_ENABLED=false
STAGE12_FAST_POLL_SECONDS=15
STAGE12_FAST_WORKERS=8
STAGE12_EARLY_WINDOW_MINUTES=30
STAGE12_EARLY_MFE_MAX_PCT=0.35
STAGE12_EARLY_CLOSE_MAE_PCT=1.00
STAGE12_EARLY_CLOSE_PNL_PCT=0.60
STAGE12_EARLY_REDUCE_PNL_PCT=0.35
STAGE12_EARLY_MIN_CONTRADICTIONS=2
STAGE12_PROTECT_ARM_MFE_PCT=0.50
STAGE12_PROTECT_REDUCE_GIVEBACK_RATIO=0.55
STAGE12_PROTECT_CLOSE_GIVEBACK_RATIO=0.80
STAGE12_FAST_RET3_THRESHOLD_PCT=0.10
STAGE12_FAST_OI_MIN_CHANGE_PCT=0.05

# PP-DECISION V4 / Stage 1 / High-Frequency Observability Benchmark.
# One canonical Binance USD-M Futures batch ticker snapshot per cycle.
# Research observation only: no REDUCE/CLOSE, paper-order, or live-order authority.
PP_V4_STAGE1_ENABLED=false
PP_V4_STAGE1_START_MS=0
PP_V4_STAGE1_POLL_SECONDS=5
PP_V4_STAGE1_ARM_PCT=0.30

# PT-L2 / Parallel Profit Protector Shadow.
# Keep disabled until PT-L3 isolates Stage12 Health execution authority.
# When enabled later:
# - PAPER_TRADING_ENABLED must be true
# - PAPER_LONG_DETECTOR_POLICY must be stage3c7a
# - LIVE_TRADING_ENABLED must remain false
# - PP_V4_STAGE1_ENABLED must be true
# - PROTECTION_SHADOW_START_MS must exactly equal PP_V4_STAGE1_START_MS
# Production cohort is Stage3C7A LONG only; all four branches have authority NONE.
PROTECTION_SHADOW_RUNTIME_ENABLED=false
PROTECTION_SHADOW_START_MS=0
PROTECTION_SHADOW_MAX_RAW_SYMBOLS=6
PROTECTION_SHADOW_RAW_MAX_PAGES=5

# PT-L3 / Stage12 Health Authority Isolation.
# Keep false until the fresh PT-L2 shadow epoch is ready.
# When true, Health REDUCE/CLOSE becomes observer-only ONLY for a parity-valid
# Stage3C7A LONG source that already has an OPEN PT-L2 shadow parent.
# Missing/invalid shadow state or observer-ledger persistence errors fail open
# to the legacy Health execution path.
PTL3_HEALTH_OBSERVER_ONLY_ENABLED=false

# Stage 15 stays bounded even after it is explicitly enabled later.
LIVE_NOTIONAL_USDT=25
LIVE_MAX_NOTIONAL_USDT=50
LIVE_MAX_OPEN_POSITIONS=1
LIVE_LEVERAGE=1
LIVE_HARD_STOP_PCT=1.5
LIVE_DAILY_LOSS_LIMIT_USDT=10
LIVE_MAX_LOSS_STREAK=3
LIVE_MIN_PAPER_CLOSED_TRADES=20
LIVE_REQUIRE_PAPER_NET_PNL_NONNEGATIVE=true
LIVE_ENTRY_MAX_AGE_MINUTES=10
LIVE_REDUCE_FRACTION=0.50
LIVE_MAX_SPREAD_BPS=20
LIVE_BALANCE_BUFFER_MULTIPLIER=1.25
LIVE_POLL_SECONDS=10

# Hard performance cohort boundary: Stage 13 V2 resumed RUN on 2026-09-29.
ENTRY_REBUILD_COHORT_BOUNDARY_MS=1790655250219

# Legacy adaptive/S5-A/B/C and PP-DECISION V1 shadow harnesses were retired
# from production runtime. Their source/tests remain under research/archive for audit.
# The frozen V1 FINAL decision contract used by V2 now lives in
# market_radar/profit_protection_v1.py.

# PP-DECISION V2 / Stage 3 / Prospective Fast Shadow.
# Uses the existing Stage 12 fast loop (default 15s) and records every V2 observation.
# Only positions opened strictly after PP_DECISION_V2_STAGE3_START_MS are included.
# Observation-only: it never changes PP-LEGACY V3 paper actions while under test.
PP_DECISION_V2_STAGE3_ENABLED=false
PP_DECISION_V2_STAGE3_START_MS=0

# PP-DECISION V2 / Stage 5 / Runner-vs-Failure Discriminator Shadow.
# Observation-only classifier attached to the active Stage 3 fast shadow.
# It never changes HOLD/REDUCE/CLOSE actions. Only post-boundary positions qualify.
PP_DECISION_V2_STAGE5_DISCRIMINATOR_ENABLED=false
PP_DECISION_V2_STAGE5_START_MS=0

# PP-DECISION V2 / Stage 6 / Prospective Discriminator Validation.
# Finalizes closed post-boundary Stage 5 cases and compares Stage 3 vs 15s/30s grace.
# Shadow validation only; it cannot change trading actions.
PP_DECISION_V2_STAGE6_VALIDATION_ENABLED=false
PP_DECISION_V2_STAGE6_START_MS=0

# PP-DECISION V2 / Stage 7 / Ambiguous Recovery Gate shadow.
# Classifies Stage 5 AMBIGUOUS cases after the causal observation window.
# No trading authority; records GRACE_CANDIDATE vs PROTECT_CANDIDATE only.
PP_DECISION_V2_STAGE7_ENABLED=false
PP_DECISION_V2_STAGE7_START_MS=0


# PP-DECISION V4 / Stage 2D / prospective two-regime shadow.
# Research-only hypothetical REDUCE/CLOSE records. Zero paper/live order authority.
PP_V4_STAGE2D_SHADOW_ENABLED=false
PP_V4_STAGE2D_START_MS=0