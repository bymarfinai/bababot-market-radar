# BabaBot core-prod runtime.
# Copy to .env and replace all CHANGE_ME values.
# Never commit .env or .env.* runtime copies.

# Public HTTPS endpoints used by Caddy.
API_DOMAIN=core-prod.43-153-193-103.sslip.io
DASHBOARD_DOMAIN=radar.43-153-193-103.sslip.io

# PostgreSQL (internal Docker network only; no public 5432 mapping).
POSTGRES_DB=bababot
POSTGRES_USER=bababot
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD

# Safe defaults. Production may enable paper/AI after restore and validation.
PAPER_TRADING_ENABLED=false
AI_APPROVAL_ENABLED=false
LIVE_TRADING_ENABLED=false

# Browser control plane.
CONTROL_API_TOKEN=CHANGE_ME_LONG_RANDOM_CONTROL_TOKEN

# Binance credentials. Keep blank while live trading is disabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI providers/models used by the current production architecture.
AI_PROVIDER=clario
AI_PRIMARY_PROVIDER=clario
AI_PRIMARY_MODEL=gemini-3.7-flash

# Stage 11 V3 fast pool: one signal is reviewed by one fast lane.
AI_FAST_POOL_TARGETS=clario:gemini-3.7-flash,thirty:thirty/gpt-5.6-luna
AI_APPROVAL_WORKERS=4
AI_APPROVAL_MAX_PER_SCAN=24
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS=2
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS_CLARIO=2
AI_APPROVAL_MIN_CALL_INTERVAL_SECONDS_THIRTY=2

# Stage 11C deterministic fresh-direction gate.
STAGE11C_MAX_PER_CYCLE=12
STAGE11C_MAX_SIGNAL_AGE_SECONDS=180
STAGE11C_MAX_APPROVAL_AGE_SECONDS=120
STAGE11C_FILL_MAX_AGE_SECONDS=30
STAGE11C_MAX_CHASE_PCT=0.75
STAGE11C_MAX_ADVERSE_PCT=0.75
STAGE11C_RET1_THRESHOLD_PCT=0.01
STAGE11C_RET3_THRESHOLD_PCT=0.03
STAGE11C_TAKER_BUY_SHARE=0.55
STAGE11C_TAKER_SELL_SHARE=0.45

CLARIO_API_KEY=
THIRTY_API_KEY=

# Paper trading defaults currently used on core-prod.
PAPER_NOTIONAL_USDT=500
PAPER_MAX_OPEN_POSITIONS=5
PAPER_POLL_SECONDS=10

# Stage 15 stays bounded even after it is explicitly enabled later.
LIVE_NOTIONAL_USDT=25
LIVE_MAX_NOTIONAL_USDT=50
LIVE_MAX_OPEN_POSITIONS=1
LIVE_LEVERAGE=1
LIVE_HARD_STOP_PCT=1.5
LIVE_DAILY_LOSS_LIMIT_USDT=10
LIVE_MAX_LOSS_STREAK=3
LIVE_MIN_PAPER_CLOSED_TRADES=20
LIVE_REQUIRE_PAPER_NET_PNL_NONNEGATIVE=true
LIVE_ENTRY_MAX_AGE_MINUTES=10
LIVE_REDUCE_FRACTION=0.50
LIVE_MAX_SPREAD_BPS=20
LIVE_BALANCE_BUFFER_MULTIPLIER=1.25
LIVE_POLL_SECONDS=10
